# AgroSense farm-frontend — contoh konfigurasi (tanpa nilai rahasia asli).
# Salin ke .env untuk run lokal: cp .env.example .env
API_PREDICT_RISK=https://[API_ID].execute-api.[REGION].amazonaws.com/[STAGE]/predict-risk
API_GATEWAY_KEY=[API_KEY]
YIELD_HISTORY_TABLE=[YIELD_HISTORY_TABLE]
AWS_REGION=[REGION]
PORT=3000
